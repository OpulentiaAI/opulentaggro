# CLOUD AGENT REMOTE — production Railway + Vercel (tracked template, no secrets)
# Copy: cp config/cloud-agent-remote.env.example config/cloud-agent-remote.env
# Fill API keys from: railway logs --service erpnext --lines 200 | grep api_key
# Load: source scripts/load_cloud_agent_env.sh

# --- Production URLs ---------------------------------------------------------
ERPNEXT_URL=https://erpnext-production-512a.up.railway.app
FRAPPE_SITE_URL=https://erpnext-production-512a.up.railway.app
VERCEL_URL=https://vercel-indol-phi-69.vercel.app
VERCEL_MCP_URL=https://vercel-indol-phi-69.vercel.app/api/mcp
NEXT_PUBLIC_ERPNEXT_URL=https://erpnext-production-512a.up.railway.app
NEXT_PUBLIC_APP_NAME=OpulentAggro

# --- Auth (Railway API token + Vercel service session) -----------------------
ERPNEXT_API_KEY=<from-railway-logs>
ERPNEXT_API_SECRET=<from-railway-logs>
ERPNEXT_AUTH_MODE=service_session
ERPNEXT_SERVICE_USER=Administrator
ERPNEXT_SERVICE_PASSWORD=<demo-admin-password>
ERPNEXT_DEV_USER=Administrator
ERPNEXT_DEV_PASSWORD=<demo-admin-password>
# ERPNEXT_NO_AUTH=1   # localhost only — never set for remote/production

# --- MCP ---------------------------------------------------------------------
FRAPPE_DESK_PROXY=1
FRAPPE_SITE_NAME=erpnext-production-512a.up.railway.app
MCP_AUTH_TOKEN=

# --- Browser login (Vercel desk + optional direct Railway desk) --------------
DEMO_ADMIN_USER=Administrator
DEMO_ADMIN_PASSWORD=<demo-admin-password>
DEMO_ADMIN_EMAIL=demo@opulentaggro.local
FRAPPE_ADMIN_PASSWORD=<demo-admin-password>

# --- Test fixtures (hosted seed defaults) ------------------------------------
STO_TEST_COMPANY="Opulent Fresh NA"
STO_TEST_SUPPLIER="Internal Supplier Opulent Fresh APAC"
STO_TEST_ITEM=STO-TEST-ITEM-001
STO_TEST_WAREHOUSE="Stores - OFAP"
IC_TEST_FROM_COMPANY="Opulent Fresh APAC"
IC_TEST_TO_COMPANY="Opulent Fresh NA"

# --- Optional (scripts / alignment) ------------------------------------------
BENCH_DIR=/path/to/sto-frappe-bench
REPORT=docs/hosted-mcp-results.json
