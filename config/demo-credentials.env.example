FRAPPE_ADMIN_PASSWORD=your-demo-password-here
ERPNEXT_DEV_USER=Administrator
ERPNEXT_DEV_PASSWORD=your-demo-password-here

# --- Site ---
FRAPPE_SITE_NAME=sto.local
FRAPPE_SITE_URL=http://localhost:8000
