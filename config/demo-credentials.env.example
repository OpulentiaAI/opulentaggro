# --- Redis (local, no auth) ---
STO_REDIS_CACHE_HOST=127.0.0.1
STO_REDIS_CACHE_PORT=6379
STO_REDIS_QUEUE_HOST=127.0.0.1
STO_REDIS_QUEUE_PORT=6380
