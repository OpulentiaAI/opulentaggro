# --- ERPNext API / MCP ---
# Local dev:
ERPNEXT_URL=http://localhost:8000
ERPNEXT_NO_AUTH=1
# Production (Railway + Vercel) — copy keys from Railway site desk, NOT localhost
# ERPNEXT_URL=https://erpnext-production-512a.up.railway.app
# ERPNEXT_NO_AUTH=     # leave unset for production
# ERPNEXT_API_KEY=     # User → Administrator → API Access on Railway site
# ERPNEXT_API_SECRET=
# MCP_AUTH_TOKEN=      # optional; Vercel /api/mcp Bearer

# --- Vercel login preset (public username only — never put password in NEXT_PUBLIC_*) ---
