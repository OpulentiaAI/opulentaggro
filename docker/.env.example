# Docker Compose — start_infra.sh loads config/demo-credentials.env and exports these vars.
# Manual: source ../scripts/load_env.sh && cd docker && docker compose up -d mariadb
#
# STO_MYSQL_HOST=127.0.0.1
# STO_MYSQL_PORT=3306
# STO_MYSQL_ROOT_PASSWORD=sto_root_dev
# STO_MYSQL_DATABASE=frappe
# STO_MYSQL_USER=frappe
# STO_MYSQL_PASSWORD=frappe_dev
# STO_REDIS_CACHE_HOST=127.0.0.1
# STO_REDIS_CACHE_PORT=6379
# STO_REDIS_QUEUE_HOST=127.0.0.1
# STO_REDIS_QUEUE_PORT=6380
