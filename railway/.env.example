# Railway environment template — OpulentAggro ERPNext backend
# Copy values into Railway service variables (never commit real secrets).

# --- Site ---
FRAPPE_SITE_NAME=erpnext-production-512a.up.railway.app
FRAPPE_ADMIN_PASSWORD=change-me-strong-password
SITE_HOST=erpnext-production-512a.up.railway.app

# --- MariaDB (Railway MariaDB plugin — use reference variables in dashboard) ---
# Prefer ${{MariaDB.*}} references; entrypoint also accepts MYSQL_URL / MYSQL* / MARIADB_*.
DB_HOST=${{MariaDB.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=3306
DB_NAME=${{MariaDB.MARIADB_DATABASE}}
DB_USER=${{MariaDB.MARIADB_USER}}
DB_PASSWORD=${{MariaDB.MARIADB_PASSWORD}}
DB_ROOT_PASSWORD=${{MariaDB.MARIADB_ROOT_PASSWORD}}
# MYSQL_URL=${{MySQL.MYSQL_URL}}

# --- Redis (bundled in erpnext container on free tier) ---
REDIS_CACHE_URL=redis://127.0.0.1:6379
REDIS_QUEUE_URL=redis://127.0.0.1:6379
REDIS_SOCKETIO_URL=redis://127.0.0.1:6379

# --- Bench / runtime ---
FRAPPE_BRANCH=version-15
ERPNEXT_BRANCH=version-15
DEVELOPER_MODE=0
WORKERS=2

# --- Site bootstrap ---
# FIRST BOOT ONLY — recreate site when volume has stale DB user (IPv6 denied / MariaDB reset)
RECREATE_SITE_ON_DB_FAILURE=1
FORCE_RECREATE_SITE=0

# AFTER FIRST SUCCESSFUL BOOT — change both to 0 in Railway dashboard (do not leave at 1):
# RECREATE_SITE_ON_DB_FAILURE=0
# FORCE_RECREATE_SITE=0
# Leaving RECREATE_SITE_ON_DB_FAILURE=1 after boot can drop/recreate the site on any DB blip.

# --- Post-deploy seed (optional) ---
RUN_MCP_SEED=1
RUN_STO_TEST_SEED=1
GENERATE_API_KEYS=1
PRINT_API_KEYS=1

# --- Generated after deploy (for Vercel frontend) ---
# ERPNEXT_URL=https://erpnext-production-512a.up.railway.app
# ERPNEXT_API_KEY=<from Railway logs or generate-production-api-keys.sh>
# ERPNEXT_API_SECRET=<from Railway logs>
