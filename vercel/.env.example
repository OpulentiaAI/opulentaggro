# Remote ERPNext instance (required for pages + API proxies)
ERPNEXT_URL=https://your-erpnext-site.example.com

# Production auth — API token from ERPNext User > API Access
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Optional: protect /api/mcp with Bearer token (recommended in production)
MCP_AUTH_TOKEN=

# Public URLs (client-safe)
NEXT_PUBLIC_ERPNEXT_URL=https://your-erpnext-site.example.com
NEXT_PUBLIC_APP_NAME=OpulentAggro

# Frappe desk iframe proxy at /erpnext (session cookie forwarded from /login)
# FRAPPE_DESK_PROXY=1

# Service session for desk proxy when user is not logged in (server-only)
# ERPNEXT_SERVICE_USER=Administrator
# ERPNEXT_SERVICE_PASSWORD=your-demo-password

# Prefer service session over API token when both are set (recommended for Railway)
# ERPNEXT_AUTH_MODE=service_session

# Local full-stack only (localhost ERPNext + session login)
# ERPNEXT_NO_AUTH=1
# ERPNEXT_DEV_USER=Administrator
# ERPNEXT_DEV_PASSWORD=your-demo-password
