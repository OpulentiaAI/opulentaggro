# Remote ERPNext instance (required for pages + API proxies)
ERPNEXT_URL=https://your-erpnext-site.example.com

# Production auth — API token from ERPNext User > API Access
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Auth strategy: service_session (desk proxy) or api_token (MCP/REST)
# ERPNEXT_AUTH_MODE=service_session

# Optional: protect /api/mcp with Bearer token (recommended in production)
MCP_AUTH_TOKEN=

# Public URLs (client-safe)
NEXT_PUBLIC_ERPNEXT_URL=https://your-erpnext-site.example.com
NEXT_PUBLIC_APP_NAME=OpulentAggro
# NEXT_PUBLIC_DEMO_USER=Administrator

# Frappe desk iframe proxy at /erpnext (session cookie forwarded from /login)
# FRAPPE_DESK_PROXY=1

# Service session for desk proxy when user is not logged in (server-only)
# ERPNEXT_SERVICE_USER=Administrator
# ERPNEXT_SERVICE_PASSWORD=your-demo-password

# Local full-stack only (localhost ERPNext + session login)
# ERPNEXT_NO_AUTH=1
# ERPNEXT_DEV_USER=Administrator
# ERPNEXT_DEV_PASSWORD=your-demo-password

# Optional: enforce login on /app/* routes
# ERPNEXT_REQUIRE_LOGIN=true

# Frappe site name (local: sto.local; Railway: your-site.up.railway.app)
# FRAPPE_SITE_NAME=sto.local

# MCP proxy base URLs (local dev: http://localhost:3000)
# VERCEL_URL=http://localhost:3000
# VERCEL_MCP_URL=http://localhost:3000/api/mcp

# STO / IC integration test overrides (scripts)
# STO_TEST_COMPANY="Opulent Fresh NA"
# STO_TEST_SUPPLIER="Internal Supplier Opulent Fresh EU"
# STO_TEST_ITEM=STO-TEST-ITEM-001
# STO_TEST_WAREHOUSE="Stores - OFEU"
# IC_TEST_FROM_COMPANY="Opulent Fresh EU"
# IC_TEST_TO_COMPANY="Opulent Fresh NA"
